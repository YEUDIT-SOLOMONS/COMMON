{
  "hosting": {
    "site": "commonrent",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/i/**",
        "run": {
          "serviceId": "photorental-api",
          "region": "me-west1"
        }
      },
      {
        "source": "/img/**",
        "run": {
          "serviceId": "photorental-api",
          "region": "me-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "{/,/index.html,/login,/register,/contact,/profile,/terms,/forgot-password,/reset-password,/order-paid,/admin,/loan-action/**,/order/**,/item-action/**,/commission-proof,/commission-pay,/commission-paid,/shipping-paid}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
